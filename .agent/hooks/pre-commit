#!/usr/bin/env bash
# ==============================================================================
# Hook Universal de Pre-Commit (Gobernanza de IA y Puerta de Calidad/Seguridad)
# ==============================================================================
# Fases de Validación:
#   1. Telemetría y Live Tracking: Sincronización automática de PROXIMOS_PASOS.md
#   2. Blindaje de Inmutabilidad: Protección del núcleo (.agent/hooks, AGENTS.md)
#   3. Escáner SAST de Staging: Bloqueo de user_data, secretos y rutas privadas
#   4. Hook Chaining Local: Ejecución de pre-commit-local.sh (si existe)
# ==============================================================================

set -eo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
TRACKING_FILE="$REPO_ROOT/PROXIMOS_PASOS.md"

echo "🔍 [Hook Pre-commit] Iniciando verificaciones automáticas de calidad y seguridad..."

# ------------------------------------------------------------------------------
# 1. Telemetría y Live Tracking de Git en PROXIMOS_PASOS.md
# ------------------------------------------------------------------------------
if [ -f "$TRACKING_FILE" ]; then
    BRANCH="$(git branch --show-current 2>/dev/null || true)"
    if [ -z "$BRANCH" ]; then
        BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || echo 'main')"
    fi
    LAST_COMMIT="$(git log -1 --format='%h — *%s*' 2>/dev/null || true)"
    [ -z "$LAST_COMMIT" ] && LAST_COMMIT="Inicial"
    NOW="$(date '+%Y-%m-%d %H:%M')"

    # Actualizar campos de telemetría preservando el resto del archivo
    sed -i "s|^- \*\*Rama activa:\*\*.*|- **Rama activa:** \`$BRANCH\`|" "$TRACKING_FILE"
    sed -i "s|^- \*\*Último commit consolidado:\*\*.*|- **Último commit consolidado:** \`$LAST_COMMIT\`|" "$TRACKING_FILE"
    sed -i "s|^- \*\*Fecha de última sincronización:\*\*.*|- **Fecha de última sincronización:** $NOW|" "$TRACKING_FILE"

    # Incorporar al staging de Git si hubo cambios
    git add "$TRACKING_FILE"
    echo "  ✔ [Live Tracking] PROXIMOS_PASOS.md sincronizado con Git ($BRANCH | $NOW)."
fi

# ------------------------------------------------------------------------------
# 2. Blindaje de Inmutabilidad del Núcleo de Gobernanza en Ramas Secundarias
# ------------------------------------------------------------------------------
CURRENT_BRANCH="$(git branch --show-current 2>/dev/null || true)"
[ -z "$CURRENT_BRANCH" ] && CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"

if [ "$CURRENT_BRANCH" != "main" ] && [ -n "$CURRENT_BRANCH" ]; then
    PROTECTED_CORE_ITEMS=(
        ".agent/hooks"
        ".agent/rules/AGENTS.md"
        ".github/workflows"
        ".gitattributes"
    )

    # Identificar Administrador de Gobernanza si existe en docs/scrum/active_roles.env o team.md
    GOV_ADMIN=""
    ROLES_ENV="$REPO_ROOT/docs/scrum/active_roles.env"
    if [ -f "$ROLES_ENV" ]; then
        GOV_ADMIN="$(grep -E '^[[:space:]]*GOVERNANCE_ADMIN=' "$ROLES_ENV" 2>/dev/null | cut -d'=' -f2 | tr -d '\"' | tr -d "'" | tr -d '[:space:]' || true)"
    fi
    [ -z "$GOV_ADMIN" ] && GOV_ADMIN="FSolaje"
    GOV_ADMIN_NAME="$(grep -F "@$GOV_ADMIN" "$REPO_ROOT/docs/scrum/team.md" 2>/dev/null | head -n1 | cut -d'|' -f2 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true)"

    CURRENT_COMMITER="$(gh api user --jq '.login' 2>/dev/null || git config user.name 2>/dev/null || echo '')"

    for item in "${PROTECTED_CORE_ITEMS[@]}"; do
        # Excepción 1: pre-commit-local.sh es el hook local del proyecto. Puede
        # crearse o modificarse en ramas secundarias sin alterar el núcleo.
        mapfile -t CHANGED_PROTECTED < <(
            git diff --cached --name-only -- "$item" 2>/dev/null \
                | grep -v '^\.agent/hooks/pre-commit-local\.sh$' || true
        )
        if [ "${#CHANGED_PROTECTED[@]}" -gt 0 ]; then
            DIFF_WITH_MAIN=$(git diff --cached main -- "${CHANGED_PROTECTED[@]}" 2>/dev/null || git diff --cached origin/main -- "${CHANGED_PROTECTED[@]}" 2>/dev/null || true)
            if [ -n "$DIFF_WITH_MAIN" ]; then
                # Excepción 2: Bypass del Administrador de Gobernanza
                # Condición obligatoria: TODOS los archivos del staging deben ser estrictamente de gobernanza o proceso.
                NON_GOVERNANCE_STAGED=$(git diff --cached --name-only | grep -Ev '^(\.agent/|\.github/|\.gitattributes$|docs/|PROXIMOS_PASOS\.md$|scripts/)' || true)
                
                if [ -n "$NON_GOVERNANCE_STAGED" ]; then
                    echo "❌ [ERROR DE GOBERNANZA - MEZCLA PROHIBIDA]"
                    echo "   Se intentan confirmar cambios en el núcleo de gobernanza ($item) junto con archivos ajenos:"
                    echo "$NON_GOVERNANCE_STAGED" | sed 's/^/      - /'
                    echo "   El bypass de gobernanza exige que el commit afecte EXCLUSIVAMENTE a activos de gobernanza."
                    exit 1
                fi

                IS_GOV_ADMIN=false
                if [ "$CURRENT_COMMITER" = "$GOV_ADMIN" ] || [ -n "$GOV_ADMIN_NAME" -a "$CURRENT_COMMITER" = "$GOV_ADMIN_NAME" ] || [ "$GOV_ADMIN" = "FSolaje" -a "$CURRENT_COMMITER" = "Fran Tomás" ] || [ "${ALLOW_GLOBAL_OVERRIDE:-false}" = "true" ] || [ "${GOVERNANCE_BYPASS:-false}" = "true" ]; then
                    IS_GOV_ADMIN=true
                fi

                if [ "$IS_GOV_ADMIN" = true ]; then
                    echo "  🛡️  [Gobernanza] Bypass de Administrador de Gobernanza concedido para @$GOV_ADMIN."
                    echo "     Commit compuesto al 100 % por activos de gobernanza. Se autoriza la modificación en '$CURRENT_BRANCH'."
                else
                    echo "❌ [ERROR DE GOBERNANZA - NÚCLEO INMUTABLE]"
                    echo "   Se intentan confirmar modificaciones no autorizadas en el activo central: '$item'"
                    echo "   Este componente transversal solo puede modificarse en 'main' o por el Administrador de Gobernanza (@$GOV_ADMIN)."
                    echo "   Para aplicar cambios legítimos al núcleo:"
                    echo "     1. Cambia a 'main' (git switch main)."
                    echo "     2. Aplica y justifica el cambio mediante Conventional Commits."
                    echo "     3. Sincroniza hacia tu rama (git restore --source=main -- $item)."
                    echo "   (Para overrides excepcionales de gobernanza: export GOVERNANCE_BYPASS=true)."
                    exit 1
                fi
            fi
        fi
    done
elif [ "$CURRENT_BRANCH" = "main" ]; then
    # Protección de 'main' como rama estricta de producción:
    # Bloquea commits o merges en 'main' que introduzcan código de producto o specs de PBIs
    # sin especificación formal de paso a producción y orden explícita (PRODUCTION_RELEASE_APPROVED=true).
    NON_GOV_ON_MAIN=$(git diff --cached --name-only --diff-filter=ACM | grep -Ev '^(\.agent/|\.github/|\.gitattributes$|docs/scrum/|docs/decisiones/|PROXIMOS_PASOS\.md$|scripts/|README\.md$|CHANGELOG\.md$)' || true)
    if [ -n "$NON_GOV_ON_MAIN" ] && [ "${PRODUCTION_RELEASE_APPROVED:-false}" != "true" ]; then
        echo "❌ [ERROR DE GOBERNANZA - RAMA MAIN ES PRODUCCIÓN]"
        echo "   Se intentan confirmar o fusionar archivos de desarrollo o PBI directamente en 'main':"
        echo "$NON_GOV_ON_MAIN" | sed 's/^/      - /'
        echo "   La rama 'main' es estrictamente de producción y nunca puede contener código ni desarrollo a mitad."
        echo "   Todo el desarrollo del Sprint debe integrarse en 'develop'."
        echo "   Para realizar un merge de paso a producción al cierre del Sprint:"
        echo "     1. Especifica formalmente el merge hacia 'main' (alcance, PBIs cerrados y suite en verde)."
        echo "     2. Solicita y recibe la orden humana explícita: 'Mandar a producción' / 'Procede con el paso a producción'."
        echo "     3. Ejecuta la operación con: PRODUCTION_RELEASE_APPROVED=true"
        exit 1
    fi
fi

# ------------------------------------------------------------------------------
# 2.5. Comprobación y Asistencia del Entorno Local de Seguridad (user_data/security/)
# ------------------------------------------------------------------------------
SECURITY_DIR="$REPO_ROOT/user_data/security"
LOCAL_PATTERNS_FILE="$SECURITY_DIR/forbidden_patterns.txt"
LOCAL_TOKEN_FILE="$SECURITY_DIR/gh_token.txt"

if [ ! -d "$SECURITY_DIR" ] || [ ! -f "$LOCAL_PATTERNS_FILE" ]; then
    echo "ℹ️  [Seguridad Local] Inicializando entorno de protección privada en user_data/security/..."
    mkdir -p "$SECURITY_DIR"
    chmod 700 "$SECURITY_DIR" 2>/dev/null || true

    if [ ! -f "$LOCAL_PATTERNS_FILE" ]; then
        cat << 'EOF' > "$LOCAL_PATTERNS_FILE"
# ==============================================================================
# PATRONES PRIVADOS LOCALES (user_data/security/forbidden_patterns.txt)
# ==============================================================================
# Este archivo reside dentro de user_data/ y está ESTRICTAMENTE IGNORADO en Git.
# Define rutas y patrones locales confidenciales que el hook SAST debe bloquear.
# ==============================================================================

EOF
        if [ -n "${HOME:-}" ] && [ "$HOME" != "/" ]; then
            echo "# Ruta personal autodetectada de la estación de trabajo" >> "$LOCAL_PATTERNS_FILE"
            echo "$HOME/" >> "$LOCAL_PATTERNS_FILE"
        fi
        chmod 600 "$LOCAL_PATTERNS_FILE" 2>/dev/null || true
        echo "   ✔ Creado: user_data/security/forbidden_patterns.txt (permisos 600)."
    fi

    if [ ! -f "$LOCAL_TOKEN_FILE" ]; then
        cat << 'EOF' > "$LOCAL_TOKEN_FILE"
# Token personal de GitHub CLI (gh) — Opcional (solo para gestión CLI de tableros/issues)
# Si solo desarrollas código funcional, este archivo puede dejarse en blanco.
# Para configurarlo interactivamente: bash scripts/github/gh-auth-env.sh --login
EOF
        chmod 600 "$LOCAL_TOKEN_FILE" 2>/dev/null || true
        echo "   ✔ Plantilla creada: user_data/security/gh_token.txt (opcional, permisos 600)."
    fi
else
    # Asegurar permisos restrictivos en instalaciones existentes
    chmod 700 "$SECURITY_DIR" 2>/dev/null || true
    chmod 600 "$LOCAL_PATTERNS_FILE" 2>/dev/null || true
    [ -f "$LOCAL_TOKEN_FILE" ] && chmod 600 "$LOCAL_TOKEN_FILE" 2>/dev/null || true
fi

# ------------------------------------------------------------------------------
# 3. Escáner SAST de Secretos, Credenciales y Rutas Privadas en Staging
# ------------------------------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$STAGED_FILES" ]; then
    # 3.1. Bloqueo estricto del directorio user_data/
    if echo "$STAGED_FILES" | grep -E '^user_data/' >/dev/null; then
        echo "❌ [ERROR DE SEGURIDAD] Se detectaron archivos del directorio confidencial 'user_data/' en staging."
        echo "   La constitución de gobernanza prohíbe terminantemente versionar contenido de 'user_data/'."
        exit 1
    fi

    # 3.2. Marcadores de conflicto Git sin resolver
    CONFLICT_LINES=$(git diff --cached | grep -En '^\+[ ]*(<<<<<<<|=======|>>>>>>>)' || true)
    if [ -n "$CONFLICT_LINES" ]; then
        echo "❌ [ERROR DE CALIDAD] Marcadores de conflicto Git sin resolver detectados en el staging:"
        echo "$CONFLICT_LINES" | head -n 3
        exit 1
    fi

    # 3.3. Inspección de líneas añadidas en el diff preparado
    DIFF_CONTENT=$(git diff --cached -U0 -- . ':(exclude).agent/hooks/pre-commit')
    ADDED_LINES=$(echo "$DIFF_CONTENT" | grep -E '^\+[^\+]' || true)

    if [ -n "$ADDED_LINES" ]; then
        # Claves privadas
        if echo "$ADDED_LINES" | grep -E '^\+[ ]*-----BEGIN (RSA|OPENSSH|DSA|EC|PGP) PRIVATE KEY' >/dev/null; then
            echo "❌ [ERROR DE SEGURIDAD] Clave privada detectada en el diff preparado."
            exit 1
        fi

        # Tokens conocidos y credenciales de API
        TOKEN_REGEX='(ghp_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9_]{82}|AKIA[0-9A-Z]{16}|sk_live_[0-9a-zA-Z]{24}|sk-(proj-)?[a-zA-Z0-9_-]{20,}|ant-api-key-[a-zA-Z0-9_-]+|https://(discord\.com|discordapp\.com)/api/webhooks/[0-9]+/[a-zA-Z0-9_-]+|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,})'
        if echo "$ADDED_LINES" | grep -E "^\+.*$TOKEN_REGEX" >/dev/null; then
            echo "❌ [ERROR DE SEGURIDAD] Token de API, webhook o credencial detectada en el diff preparado."
            exit 1
        fi

        # Rutas absolutas locales de usuario en SOs (/home/*, /Users/*, C:\Users\*)
        GENERIC_USER_PATHS=$(echo "$ADDED_LINES" | grep -E '^\+.*(/home/[a-zA-Z0-9._-]+/|/Users/[a-zA-Z0-9._-]+/|[A-Za-z]:[/\\]Users[/\\][a-zA-Z0-9._-]+)' | grep -Ev 'ej\. |ejemplo|<usuario>|<user>|/home/usuario|/home/user|/home/runner' || true)
        if [ -n "$GENERIC_USER_PATHS" ]; then
            echo "⚠️  [ADVERTENCIA DE SEGURIDAD] Posible ruta absoluta local privada detectada en el diff:"
            echo "$GENERIC_USER_PATHS" | head -n 3
            echo "   Por favor, utiliza rutas relativas en lugar de rutas absolutas locales."
            exit 1
        fi

        # Detección dinámica en tiempo de ejecución de la variable HOME local
        if [ -n "${HOME:-}" ] && [ "$HOME" != "/" ]; then
            CURRENT_HOME_MATCH=$(echo "$ADDED_LINES" | grep -F "$HOME" | grep -Ev 'ej\. |ejemplo|<usuario>|<user>' || true)
            if [ -n "$CURRENT_HOME_MATCH" ]; then
                echo "❌ [ERROR DE SEGURIDAD] Se detectó la ruta del directorio personal local en el diff preparado."
                echo "$CURRENT_HOME_MATCH" | head -n 3
                echo "   Sustitúyela por una ruta relativa antes de confirmar."
                exit 1
            fi
        fi

        # Patrones confidenciales locales cargados desde user_data/security/forbidden_patterns.txt
        LOCAL_PATTERNS_FILE="$REPO_ROOT/user_data/security/forbidden_patterns.txt"
        if [ -f "$LOCAL_PATTERNS_FILE" ]; then
            while IFS= read -r pattern || [ -n "$pattern" ]; do
                [[ -z "$pattern" || "$pattern" =~ ^[[:space:]]*# ]] && continue
                MATCHES=$(echo "$ADDED_LINES" | grep -E "$pattern" || true)
                if [ -n "$MATCHES" ]; then
                    echo "❌ [ERROR DE SEGURIDAD] Coincidencia con patrón confidencial local (definido en user_data/security/forbidden_patterns.txt):"
                    echo "$MATCHES" | head -n 3
                    exit 1
                fi
            done < "$LOCAL_PATTERNS_FILE"
        fi
    fi
fi

echo "  ✔ [Seguridad] Verificación SAST de secretos y rutas privadas completada con éxito."

# ------------------------------------------------------------------------------
# 4. Hook Chaining Local: Extensión de Validaciones por Proyecto (Opcional)
# ------------------------------------------------------------------------------
LOCAL_HOOK="$REPO_ROOT/.agent/hooks/pre-commit-local.sh"
if [ -f "$LOCAL_HOOK" ]; then
    echo "  ⚙️  [Extension Hook] Ejecutando validaciones específicas locales (pre-commit-local.sh)..."
    bash "$LOCAL_HOOK"
fi

echo "  ✔ [Pre-commit] Todas las comprobaciones obligatorias superadas."
exit 0
