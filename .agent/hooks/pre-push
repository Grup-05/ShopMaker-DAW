#!/usr/bin/env bash
# ==============================================================================
# Hook Universal de Pre-Push (Gobernanza de IA y Sincronización Remota)
# ==============================================================================
# 1. Alerta ante push directo o descuidado a la rama principal 'main'
# 2. Validación de convención de nombres de rama
# 3. Comprobación de seguridad previa a la publicación en remoto
# ==============================================================================

set -eo pipefail

REMOTE="$1"
URL="$2"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

echo "🔍 [Hook Pre-push] Verificando condiciones de sincronización remota con '$REMOTE'..."

# Cargar convención personalizada de ramas si existe en el proyecto
CONVENTION_FILE="$REPO_ROOT/.agent/hooks/branch_convention.env"
if [ -f "$CONVENTION_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONVENTION_FILE"
fi

# Expresión regular estándar por defecto (GitFlow, Trunk-Based, Releases y Jerarquías Multirrama)
DEFAULT_BRANCH_REGEX='^(main|develop|dev/(feature|fix)/[a-zA-Z0-9._-]+|feature/[a-zA-Z0-9._-]+|fix/[a-zA-Z0-9._-]+|hotfix/[a-zA-Z0-9._-]+|release/v[0-9.]+(-[a-zA-Z0-9.]+)?|ra[0-9]{2}/ut[0-9]+-[a-zA-Z0-9._-]+(|/(main|base|dev(|/[a-zA-Z0-9._-]+)|fix/[a-zA-Z0-9._-]+|release/v[0-9.]+(-[a-zA-Z0-9.]+)?)))$'
VALID_BRANCH_REGEX="${BRANCH_NAMING_REGEX:-$DEFAULT_BRANCH_REGEX}"

# Leer referencias que se intentan subir: <local ref> <local sha1> <remote ref> <remote sha1>
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    if [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ]; then
        # Eliminación de rama remota
        continue
    fi

    BRANCH_NAME="${REMOTE_REF#refs/heads/}"

    # 1. Blindaje de 'main' como rama estricta de producción
    if [ "$BRANCH_NAME" = "main" ]; then
        if [ -n "$REMOTE_SHA" ] && [ "$REMOTE_SHA" != "0000000000000000000000000000000000000000" ]; then
            MAIN_REVS="$REMOTE_SHA..$LOCAL_SHA"
        else
            MAIN_REVS="$LOCAL_SHA"
        fi
        NON_GOV_PUSH_MAIN=$(git diff --name-only --diff-filter=ACM "$MAIN_REVS" 2>/dev/null | grep -Ev '^(\.agent/|\.github/|\.gitattributes$|docs/scrum/|docs/decisiones/|PROXIMOS_PASOS\.md$|scripts/|README\.md$|CHANGELOG\.md$)' || true)
        if [ -n "$NON_GOV_PUSH_MAIN" ] && [ "${PRODUCTION_RELEASE_APPROVED:-false}" != "true" ]; then
            echo "❌ [ERROR DE GOBERNANZA - BLOQUEO DE PASO A PRODUCCIÓN (main)]"
            echo "   Se intenta publicar en 'main' desarrollo o archivos de PBI sin autorización de paso a producción:"
            echo "$NON_GOV_PUSH_MAIN" | sed 's/^/      - /'
            echo "   La rama 'main' es exclusivamente de producción y nunca puede tener código ni desarrollo a mitad."
            echo "   Durante el Sprint se desarrolla e integra en 'develop'."
            echo "   Para publicar un merge a producción al cierre del Sprint:"
            echo "     1. Especifica formalmente el merge hacia 'main'."
            echo "     2. Solicita y recibe la orden explícita: 'Mandar a producción' / 'Procede con el paso a producción'."
            echo "     3. Ejecuta con: PRODUCTION_RELEASE_APPROVED=true git push origin main"
            exit 1
        fi
        echo "  🛡️  [Gobernanza] Push hacia la rama de producción 'main' verificado."
    fi

    # 2. Validación de nomenclatura de ramas
    if ! [[ "$BRANCH_NAME" =~ $VALID_BRANCH_REGEX ]]; then
        echo "⚠️  [ADVERTENCIA] El nombre de la rama '$BRANCH_NAME' no sigue el estándar recomendado:"
        echo "   - Ramas principales: main, develop"
        echo "   - Ramas de funcionalidad: dev/feature/<nombre> o feature/<nombre>"
        echo "   - Ramas de corrección:    dev/fix/<nombre> o fix/<nombre>"
        echo "   - Ramas de release:       release/v<X.Y.Z>"
        echo "   - Ramas jerárquicas:      ra<XX>/ut<Y>-<nombre>/(main|dev|fix|release/v<X.Y.Z>)"
        echo "   (Para personalizar este regex, define BRANCH_NAMING_REGEX en .agent/hooks/branch_convention.env)."
    fi

    # 3. Bloqueo de fuga de configuraciones locales privadas hacia develop o main
    if [ "$BRANCH_NAME" = "main" ] || [ "$BRANCH_NAME" = "develop" ]; then
        if [ -n "$REMOTE_SHA" ] && [ "$REMOTE_SHA" != "0000000000000000000000000000000000000000" ]; then
            REVS="$REMOTE_SHA..$LOCAL_SHA"
        else
            REVS="$LOCAL_SHA"
        fi
        LEAKED_FILES=$(git diff --name-only "$REVS" -- "user_data/" ".agent/local/" 2>/dev/null || true)
        if [ -n "$LEAKED_FILES" ]; then
            echo "❌ [ERROR DE GOBERNANZA] Intento de publicar archivos locales privados hacia '$BRANCH_NAME':"
            echo "$LEAKED_FILES" | sed 's/^/   - /'
            echo "   Los archivos locales privados no pueden integrarse en develop ni en main."
            exit 1
        fi
    fi

    # 4. Obligación de sincronización previa con 'develop' en ramas de trabajo (feature/*, fix/*, dev/*)
    if [[ "$BRANCH_NAME" =~ ^(feature/|fix/|dev/) ]]; then
        git fetch "$REMOTE" develop --quiet 2>/dev/null || true
        if git rev-parse --verify "$REMOTE/develop" >/dev/null 2>&1; then
            if ! git merge-base --is-ancestor "$REMOTE/develop" "$LOCAL_SHA" 2>/dev/null; then
                echo "❌ [ERROR DE GOBERNANZA - RAMA DESACTUALIZADA RESPECTO A 'develop']"
                echo "   La rama '$BRANCH_NAME' no incluye los últimos cambios de '$REMOTE/develop'."
                echo "   Antes de publicar una rama o abrir una Pull Request es obligatorio"
                echo "   fusionar el estado actual de 'develop' y verificar que los tests pasen:"
                echo "     1. git fetch $REMOTE develop && git merge $REMOTE/develop"
                echo "     2. Resolver cualquier conflicto en tu rama y ejecutar la suite de pruebas."
                echo "     3. Volver a ejecutar git push."
                exit 1
            fi
        fi
        echo "  ✔ [Sincronización] La rama '$BRANCH_NAME' está al día con '$REMOTE/develop'."
    fi
done

echo "  ✔ [Pre-push] Verificaciones de sincronización remota superadas."
exit 0
